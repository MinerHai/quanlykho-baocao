# Sao chép thành file ".env" cùng thư mục rồi điền giá trị. KHÔNG commit file .env.

# --- Bắt buộc ---
# Chuỗi kết nối MongoDB (local hoặc Atlas)
CONNECT_DB=mongodb://localhost:27017/ql-kho
# Origin của client cho CORS
URL_CLIENT=http://localhost:5173
# Khóa ký token / mã hóa thông tin user. Phải khớp SECRET_CRYPTO trong client/src/context/AuthContext.jsx
SECRET_CRYPTO=

# --- Ảnh: mặc định lưu trong MongoDB. Chỉ cần Cloudinary khi IMAGE_STORAGE=cloudinary ---
# IMAGE_STORAGE=mongo
# PUBLIC_SERVER_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email quên mật khẩu ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
# Gửi mail qua Gmail OAuth2 (sendMailForgotPassword.js)
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=
REFRESH_TOKEN=

# --- AI chatbot ---
GEMINI_API_KEY=
GROQ_API_KEY=
